{
  "name": "playify-edge-worker",
  "version": "1.0.0",
  "type": "module",
  "description": "Playify Sports high-performance Cloudflare Edge Worker for multi-provider stream aggregation and caching",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/index.js",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "playify",
    "cloudflare-worker",
    "sports",
    "streaming"
  ],
  "author": "Playify Engineer",
  "license": "ISC",
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "wrangler": "^3.86.0"
  }
}
